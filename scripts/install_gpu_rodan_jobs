#!/bin/sh
set -o errexit # Exit immediately if a command exits with a non-zero status.
set -o nounset # Treat unset variables as an error when substituting.
set -o xtrace # Print commands and their arguments as they are executed.

# Installs the external GPU job packages, ported to TensorFlow 2.15 / Python 3.11 for
# Hopper (sm_90) GPUs (the `py311` branch of each DDMAL repo). TensorFlow itself (with the
# CUDA 12 wheels) is installed by the gpu-celery Dockerfile via `tensorflow[and-cuda]`;
# each repo's requirements only assert `tensorflow==2.15.1` (pip sees it satisfied). On
# rodan-main (no CUDA) the same requirements pull the CPU TensorFlow, which is enough to
# import/register the jobs in the API.
#
# text_alignment's code lives inside the Rodan repo (rodan/jobs/text_alignment), so it is
# not cloned here; it only needs the OCR engine. Upstream Calamari-OCR supports py3.11 +
# TF2.15 via ocrd-fork-tfaip 1.2.7, installed from the job's own requirements below.

PIP=$(which pip3) || PIP=$(which pip)

# Background Removal
cd /
git clone -b py311 --depth 1 https://github.com/DDMAL/background_removal.git
mv background_removal .background_removal
cd .background_removal
$PIP install --no-cache-dir .

# SAE_binarization
cd /
git clone -b py311 --depth 1 https://github.com/DDMAL/SAE_binarization.git
mv SAE_binarization .SAE_binarization
cd .SAE_binarization
$PIP install --no-cache-dir .

# Paco classifier
cd /
git clone -b py311 --depth 1 https://github.com/DDMAL/Paco_classifier.git
mv Paco_classifier .Paco_classifier
cd .Paco_classifier
$PIP install --no-cache-dir .

# text_alignment (calamari OCR engine; the job code itself is in-Rodan)
$PIP install --no-cache-dir -r /code/Rodan/rodan/jobs/text_alignment/requirements.txt
